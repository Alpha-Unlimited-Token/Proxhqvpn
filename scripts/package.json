{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "audit:brand": "tsx ./src/audit-brand-consistency.ts",
    "audit:trust-center": "tsx ./src/audit-public-trust-center.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:capabilities": "pnpm --filter @workspace/api-server exec esbuild ../scripts/audit-route-capabilities.ts --bundle --platform=node --format=esm --alias:@workspace/capabilities=../lib/capabilities/src/index.ts --outfile=/tmp/proxhq-audit-cap.mjs --log-level=silent && node /tmp/proxhq-audit-cap.mjs",
    "validation:seed": "tsx ./src/seed-validation-targets.ts",
    "validation:run": "tsx ./src/run-validation-once.ts",
    "validation:export": "tsx ./src/export-validation-report.ts",
    "audit:frontend-routes": "tsx ./src/audit-frontend-routes.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
