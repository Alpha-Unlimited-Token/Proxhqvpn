# ProxhqVPN — Environment Variable Catalogue
# Alpha Unlimited Technologies LLC
# Copy this file to .env for local development. Never commit .env to version control.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/proxhqvpn

# ─── Node.js Runtime ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
BASE_PATH=/api

# ─── Clerk Authentication ─────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
ADMIN_EMAILS=alphaunlimitedtechnologies@gmail.com

# ─── Session & Internal Service Auth ─────────────────────────────────────────
# SESSION_SECRET: used for session cookie signing only
SESSION_SECRET=change-me-to-a-random-32-char-secret
# INTERNAL_SECRET: dedicated secret for X-Internal-Secret inter-service header
# Must NOT share the same value as SESSION_SECRET in production
INTERNAL_SECRET=change-me-to-a-different-32-char-secret

# ─── Cryptographic Keys ───────────────────────────────────────────────────────
# AUDIT_HMAC_KEY_B64: 32 bytes base64 — signs each audit chain entry with HMAC-SHA512
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUDIT_HMAC_KEY_B64=
# AUDIT_GENESIS_HASH: optional static genesis prev-hash (default: "GENESIS")
AUDIT_GENESIS_HASH=GENESIS
# PROXHQ_MASTER_KEY_B64: 32 bytes base64 — AES-256-GCM envelope key for WireGuard private keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROXHQ_MASTER_KEY_B64=

# ─── Daemon / Node Agent Auth ─────────────────────────────────────────────────
# DAEMON_PSK: pre-shared key for daemon-inbound route authentication
DAEMON_PSK=
# NODE_AGENT_PSK: pre-shared key for remote Parrot OS node agent check-ins
NODE_AGENT_PSK=
# HONEYPOT_PSK: pre-shared key for honeypot sensor callbacks
HONEYPOT_PSK=

# ─── Break-Glass Emergency Access ────────────────────────────────────────────
# One-time 15-minute TTL ghost-mode token. Regenerated on each use.
BREAK_GLASS_TOKEN=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (https:// required in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── SIEM Integrations ───────────────────────────────────────────────────────
# Splunk HEC
SPLUNK_HEC_URL=https://your-splunk.example.com:8088/services/collector
SPLUNK_HEC_TOKEN=
# Generic webhook (any SIEM, Slack, PagerDuty, etc.)
SIEM_WEBHOOK_URL=

# ─── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Crypto Wallet Addresses (public — no secret required) ────────────────────
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=

# ─── SMTP Email (canary token alerts, notifications) ──────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=
SMTP_FROM=alerts@proxhqvpn.com

# ─── External API Keys ───────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
GITHUB_TOKEN=
GOOGLE_BIGQUERY_KEY=
# Have I Been Pwned — breach check features
HIBP_API_KEY=

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Workers — set to "0" to disable, "1" to enable
PROXHQ_ENABLE_CRYPTO_POLLER=1
PROXHQ_ENABLE_NODE_LIFECYCLE=1
PROXHQ_ENABLE_REGISTERED_WORKERS=1
PROXHQ_ENABLE_NODE_MAINTENANCE_WORKER=1
PROXHQ_ENABLE_NODE_OFFLINE_ALERTING=1
PROXHQ_ENABLE_AUDIT_CHAIN_INTEGRITY=1
PROXHQ_ENABLE_CANARY_CLEANUP=1
PROXHQ_ENABLE_ZTNA_EXPIRY=1
# Dangerous features — must remain 0 in production
PROXHQ_ENABLE_EMBEDDED_TOR=0
PROXHQ_PRELOAD_ATTACKER_FILES=0
PROXHQ_ENABLE_SECURITY_LAB=0
PROXHQ_SKIP_SYSTEM_DEP_CHECK=0
