# ─── Required in production ───────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=
SESSION_SECRET=
CLERK_SECRET_KEY=
ALLOWED_ORIGINS=https://your-domain.com

# ─── Must stay disabled on public production deployment ───────────────────────
PROXHQ_ENABLE_SECURITY_LAB=0
PROXHQ_ENABLE_SECURITY_LAB_PROD=0
PROXHQ_ENABLE_OMEGA=0
PROXHQ_ENABLE_OMEGA_PROD=0
PROXHQ_PRELOAD_ATTACKER_FILES=0

# ─── Prefer sidecar/system service instead of embedded daemon in production ───
PROXHQ_ENABLE_EMBEDDED_TOR=0
