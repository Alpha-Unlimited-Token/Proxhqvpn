[Unit]
Description=ProxhqVPN Node Agent (telemetry check-in daemon)
Documentation=https://proxhqvpn.com/guide
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
# Soft dependency — agent still runs even if WireGuard interface is not up
PartOf=wg-quick@wg0.service

[Service]
Type=simple
User=proxhq
Group=proxhq
WorkingDirectory=/opt/proxhq
ExecStart=/usr/bin/python3 /opt/proxhq/proxhq-node-agent.py --config /etc/proxhq/config.json
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxhq-node-agent

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/proxhq
CapabilityBoundingSet=

# Resource limits
MemoryMax=64M
CPUQuota=5%

[Install]
WantedBy=multi-user.target
