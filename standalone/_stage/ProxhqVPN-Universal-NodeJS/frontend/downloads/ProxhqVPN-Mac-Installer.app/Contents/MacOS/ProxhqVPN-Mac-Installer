#!/bin/bash
# ProxhqVPN macOS Installer
# © 2026 ALPHA UNLIMITED TECHNOLOGIES LLC
# This script runs silently — only native macOS dialogs appear.

APP_DEST="/Applications/ProxhqVPN.app"
USER_APP_DEST="$HOME/Applications/ProxhqVPN.app"
PROXHQ_URL="https://proxhqvpn.com"

dialog() {
  osascript -e "display dialog \"$1\" with title \"$2\" buttons {$3} default button $4 with icon note" -e "button returned of result" 2>/dev/null
}

notify() {
  osascript -e "display notification \"$1\" with title \"ProxhqVPN\" subtitle \"$2\"" 2>/dev/null
}

# ── Step 1: Welcome ───────────────────────────────────────────────────────────
BTN=$(dialog \
  "Welcome to ProxhqVPN\n\nThis wizard will install ProxhqVPN on your Mac in just a few steps.\n\n• Military-grade WireGuard encryption\n• Zero-logs privacy policy\n• Instant kill switch protection\n• Double-hop anonymity routing\n\nClick Continue to get started." \
  "ProxhqVPN Installer" \
  '"Quit", "Continue"' \
  '"Continue"')

[ "$BTN" = "Quit" ] && exit 0

# ── Step 2: License ───────────────────────────────────────────────────────────
BTN=$(dialog \
  "License Agreement\n\nBy continuing you agree to ProxhqVPN's Terms of Service.\n\nThis software is provided by ALPHA UNLIMITED TECHNOLOGIES LLC for personal and commercial use. Redistribution or reverse engineering is prohibited.\n\nFull terms: proxhqvpn.com/terms" \
  "ProxhqVPN — License Agreement" \
  '"Decline", "I Agree"' \
  '"I Agree"')

[ "$BTN" = "Decline" ] && exit 0

# ── Step 3: Install Location ──────────────────────────────────────────────────
BTN=$(dialog \
  "Install Location\n\nWhere would you like to install ProxhqVPN?\n\n• All Users — installs to /Applications (requires your Mac password)\n• Just Me — installs to your personal Applications folder" \
  "ProxhqVPN — Install Location" \
  '"Just Me", "All Users"' \
  '"All Users"')

INSTALL_ALL_USERS=false
[ "$BTN" = "All Users" ] && INSTALL_ALL_USERS=true

# ── Step 4: WireGuard ─────────────────────────────────────────────────────────
BTN=$(dialog \
  "WireGuard Required\n\nProxhqVPN uses WireGuard for its encrypted VPN tunnels. It is not yet installed on your Mac.\n\nClick Install WireGuard to open the Mac App Store and install it for free, then return here to finish." \
  "ProxhqVPN — WireGuard" \
  '"Skip for Now", "Install WireGuard"' \
  '"Install WireGuard"')

if [ "$BTN" = "Install WireGuard" ]; then
  open "https://apps.apple.com/us/app/wireguard/id1451685025"
  dialog \
    "WireGuard is opening in the App Store.\n\nInstall WireGuard, then click Continue to finish the ProxhqVPN installation." \
    "ProxhqVPN — WireGuard" \
    '"Continue"' \
    '"Continue"' > /dev/null
fi

# ── Step 5: Installing ────────────────────────────────────────────────────────
notify "Setting up ProxhqVPN..." "Installing"

BUILD_DIR=$(mktemp -d)
STAGE="$BUILD_DIR/ProxhqVPN.app"
mkdir -p "$STAGE/Contents/MacOS"
mkdir -p "$STAGE/Contents/Resources"

cat > "$STAGE/Contents/MacOS/ProxhqVPN" << 'LAUNCHER'
#!/bin/bash
open "https://proxhqvpn.com"
LAUNCHER
chmod +x "$STAGE/Contents/MacOS/ProxhqVPN"

cat > "$STAGE/Contents/Info.plist" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>ProxhqVPN</string>
  <key>CFBundleIdentifier</key>
  <string>com.alphaunlimited.proxhqvpn</string>
  <key>CFBundleName</key>
  <string>ProxhqVPN</string>
  <key>CFBundleDisplayName</key>
  <string>ProxhqVPN</string>
  <key>CFBundleVersion</key>
  <string>1.0.0</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
PLIST

if [ "$INSTALL_ALL_USERS" = true ]; then
  osascript -e "do shell script \"cp -r '$STAGE' '/Applications/'\" with administrator privileges" 2>/dev/null
  FINAL_PATH="$APP_DEST"
else
  mkdir -p "$HOME/Applications"
  cp -r "$STAGE" "$USER_APP_DEST"
  FINAL_PATH="$USER_APP_DEST"
fi

rm -rf "$BUILD_DIR"

# ── Step 6: Done ──────────────────────────────────────────────────────────────
BTN=$(dialog \
  "ProxhqVPN is installed!\n\nYou can find ProxhqVPN in your Applications folder. Click the icon any time to open your VPN dashboard.\n\nClick Launch Now to open ProxhqVPN." \
  "Installation Complete" \
  '"Done", "Launch Now"' \
  '"Launch Now"')

[ "$BTN" = "Launch Now" ] && open "$PROXHQ_URL"

exit 0
